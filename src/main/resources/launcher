    APP="$link"
  else
    APP=$(dirname "$APP")"/$link"
  fi
done
NAME=$(basename "$APP")
APP=$(dirname "$APP")
APP=$(cd "$APP" && pwd)
APP="$APP/$NAME"
PATH=${{path}}
if [ -z $${{javaVariable}} ] ; then
  JAVA=${{java}}
else
  JAVA=$${{javaVariable}}
fi
